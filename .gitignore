.codegraph/
.codex/
.vscode/
.pytest_cache/
.venv/
*.egg-info/
__pycache__/
*.py[cod]

# Local reference checkout; keep it available for CodeGraph/reference use, not as FireClaw source.
openclaw/
emem-main/

# Runtime logs and generated local traces.
*.jsonl
logs/
results/
checkpoints/

# Plugin-local ROS build and runtime outputs.
extensions/**/ros_ws/build/
extensions/**/ros_ws/devel/
extensions/**/ros_ws/install/
extensions/**/ros_ws/log/
extensions/**/ros_ws/src/CMakeLists.txt

# Robot-platform ROS build and runtime outputs.
robots/**/ros_ws/build/
robots/**/ros_ws/devel/
robots/**/ros_ws/install/
robots/**/ros_ws/log/
robots/**/ros_ws/src/CMakeLists.txt

# Private FireClaw configs (may contain secrets). Mode-specific names are
# deliberate: never reuse a simulation config for a real robot.
/fireclaw.sim.toml
/fireclaw.real.toml
# Legacy local name; retained only so an old credential-bearing file cannot be
# committed accidentally. New commands and docs must not use it.
/fireclaw.toml
.fireclaw/

# Per-robot runtime state. These files are generated locally and may contain
# mission/site data; product fixtures must use explicit, non-runtime names.
data/mission/.cli-history
data/mission/*.sqlite
data/mission/*.sqlite-*
data/mission/*.lock
data/robots/**/embodied-memory-index.sqlite3
data/robots/**/embodied-memory-index.sqlite3-*
data/robots/**/memory-runtime.sqlite3
data/robots/**/memory-runtime.sqlite3-*

# Release artifacts, packages and superpowers scratch
.superpowers/
dist/
build/
*.whl
*.tar.gz
